<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/w_prayer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="🕌 —" />
    <TextView android:id="@+id/w_work" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFE3EAFC" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:text="🧰 —" />
    <TextView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#FFE3EAFC" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:text="🩸 —" />
    <TextView android:id="@+id/w_gym" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#FFAFC3F5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="Nhari" />
</LinearLayout>
